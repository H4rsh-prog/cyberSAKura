db.database_name=cybersakura
db.host=localhost
db.port=3306
db.username=root
db.password=userpass
db.driver_class=com.mysql.cj.jdbc.Driver


spring.datasource.url=jdbc:mysql://${db.host}:${db.port}/${db.database_name}
spring.datasource.username=${db.username}
spring.datasource.password=${db.password}
spring.datasource.driver-class-name=${db.driver_class}
spring.jpa.hibernate.ddl-auto=update